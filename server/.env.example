PORT=4500
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/open_concept_bangla
JWT_SECRET=super_secret_open_concept_bangla_key_2026_jwt
CLIENT_URL=http://localhost:5173

# Optional: Real Email SMTP Configuration (Gmail or Custom SMTP)
# If left empty, OTP will be displayed in the backend terminal console for instant dev testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="Open Concept Bangla" <no-reply@openconceptbangla.com>
